{
  "regions": ["fra1"],
  "functions": {
    "api/bw.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/bw/:path*", "destination": "/api/bw?path=:path*" },
    { "source": "/portal-media/:path*", "destination": "https://isp.bitwavetechnologies.com/media/:path*" }
  ]
}
